{
  "name": "mermaid-studio",
  "version": "1.0.0",
  "description": "A local-first desktop workspace for Mermaid software engineering diagrams.",
  "author": "Mermaid Studio Contributors",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "dist": "npm run dist:win",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File lightweight/build.ps1",
    "dist:win:electron": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.52.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.0.13",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mermaidstudio.desktop",
    "productName": "Mermaid Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Mermaid-Studio-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Mermaid-Studio-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "nsis": {
      "artifactName": "Mermaid-Studio-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "type": "module"
}
